{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bm-map-poster",
  "compatibility_date": "2026-07-26",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // トップレベルは全env共通の土台（name/main/compatibility_date/assets）のみを持つ。
  // d1_databasesを含む実際のデプロイ対象は必ず env.<地域ID> として追加する
  // （`wrangler dev`/`wrangler deploy` を --env 無しで実行すると DB バインディングが無く
  // 意図的に失敗する。「無名のデフォルト環境」は存在しない設計。旧・無名デフォルト環境
  // （bm-map-poster.workers.dev、旧D1 bm-poster-db）はenv.14213-yamatoへ移行し廃止済み
  // 〈実データ〈担当者・貼付履歴・メモ〉は引き継がず、掲示板マスタのみ再投入〉。
  // 詳細はREADME.md「複数地域の並行運用」参照。bm-map-postingと同じ設計）。
  "env": {
    "14213-yamato": {
      "name": "bm-map-poster-14213-yamato",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bm-poster-db-14213-yamato",
          "database_id": "4583aefd-90f0-4396-8403-4ed9566c9898"
        }
      ],
      "vars": {
        "REGION_DISPLAY_NAME": "大和市",
        "MAP_CENTER_LAT": 35.4717,
        "MAP_CENTER_LNG": 139.4549,
        "MAP_ZOOM": 13
      }
    }
  }
  // 複数自治体の並行運用は `env.<地域ID>` として `npm run new-region` が追記する
  // （bm-map-postingと同じ方式。詳細はREADME.md「複数地域の並行運用」参照）。
}
